# 复制本文件为 .env 并填写真实值（.env 已被 gitignore，永不入库）
# 每个字段的含义见 app/config.py

# ---------- 云端大模型（DeepSeek，OpenAI 兼容协议；也支持任意中转站的 base_url） ----------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 本地模型（Ollama；未部署/不可达时自动降级云端） ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# ---------- 邮件（163 SMTP；留空则进入模拟模式，HTML 写到 backend/data/mail_outbox/） ----------
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_mail@163.com
SMTP_PASS=your_smtp_auth_code
SMTP_TO=your_mail@163.com

# ---------- 早报 ----------
DIGEST_TOP_N=10
DIGEST_NEWS_HOURS=24

# ---------- CORS（逗号分隔） ----------
CORS_ORIGINS=http://localhost:3000,https://horseforever.cn
